# TODO: Make this Makefile.in pretty

TARGETS = epserver epwget
CC=@CC@ -g -O3 -Wall -fgnu89-inline -fcommon
DPDK=@DPDK@
CFLAGS=@CFLAGS@ $(shell pkg-config --cflags libdpdk)

# Add arch-specific optimization
ifeq ($(shell uname -m),x86_64)
LIBS += -m64
endif

# mtcp library and header 
MTCP_FLD    =../../mtcp/
MTCP_INC    =-I${MTCP_FLD}/include
MTCP_LIB    =-L${MTCP_FLD}/lib
MTCP_TARGET = ${MTCP_LIB}/libmtcp.a

UTIL_FLD = ../../util
UTIL_INC = -I${UTIL_FLD}/include
UTIL_OBJ = ${UTIL_FLD}/http_parsing.o ${UTIL_FLD}/tdate_parse.o ${UTIL_FLD}/netlib.o

# util library and header
INC = -I./include/ ${UTIL_INC} ${MTCP_INC} -I${UTIL_FLD}/include
LIBS = ${MTCP_LIB}

# dpdk-specific variables (via pkg-config)
DPDK_LIBS := $(shell pkg-config --libs libdpdk)
LIBS += -g -O3 -pthread -lrt ${MTCP_FLD}/lib/libmtcp.a -lnuma -lpthread -lrt -ldl -lgmp -lm $(DPDK_LIBS)

ifeq ($V,) # no echo
	export MSG=@echo
	export HIDE=@
else
	export MSG=@\#
	export HIDE=
endif


all: client

client.o: client.c
	$(MSG) "   CC $<"
	${CC} -g -c $< ${CFLAGS} ${INC}

client: client.o
	$(MSG) "   LD $<"
	${CC} $< ${INC} ${UTIL_OBJ} -g -o $@ ${LIBS} 

clean:
	rm -f *~ *.o ${TARGETS} log_*

distclean: clean
	rm -rf Makefile
